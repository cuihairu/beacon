<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Beacon.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- B-804/B-806：版本唯一权威基准（InformationalVersion 由它派生，关于页读这里）。
         对齐仓库最新正式发布 v0.1.2；nightly 滚动构建由 daily-build 在发布时注入日期版本，不在此处维护。 -->
    <Version>0.1.2</Version>
    <FileVersion>0.1.2.0</FileVersion>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <!-- exe 图标（Explorer/快捷方式/标题栏）；托盘图标另由 TrayIconService 按状态运行时绘制 -->
    <ApplicationIcon>Assets\beacon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged 自包含（RFC §10）：便携 exe + %AppData% 直写 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- SelfContained 需要显式 Windows RID；默认 x64，可由 -p:RuntimeIdentifier 覆盖 -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Beacon.Core\Beacon.Core.csproj" />
    <ProjectReference Include="..\Beacon.Storage\Beacon.Storage.csproj" />
    <ProjectReference Include="..\Beacon.Connections\Beacon.Connections.csproj" />
    <ProjectReference Include="..\Beacon.Actions\Beacon.Actions.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <!-- B-706：托盘图标按配置色运行时绘制（GDI+ 位图 → HICON） -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 托盘染色用的 logo 白色剪影：内嵌进程序集，发布形态不依赖散文件 -->
    <EmbeddedResource Include="Assets\tray-logo-mask.png" />
  </ItemGroup>
</Project>
