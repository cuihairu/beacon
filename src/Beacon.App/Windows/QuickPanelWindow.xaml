<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Beacon.App.Windows.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Beacon Quick Panel">
    <!-- RFC §6.4：Flyout——亚克力瞬态面 + Fluent 主题资源（WinUI 栈规范：颜色走 ThemeResource，不硬编码 hex）；
         PANEL-UPGRADE-1 看板化：720x560 大板面，事件动态（时间线）为左主区，通知/概览/状态收右副栏 -->
    <Border
        CornerRadius="{StaticResource RadiusPanel}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Padding="16">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 头部（PANEL-UPGRADE-1 拖拽移动把手）：总体状态灯 + 告警计数 + 未读通知徽标；
                 灯初值 UpdateHeader 覆盖。按住拖动整窗（PointerPressed 会话），松手落位记忆 shell-state -->
            <Grid
                x:Name="HeaderDragArea"
                Grid.Row="0"
                MinHeight="34"
                Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="OverallLight" Width="12" Height="12" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Beacon" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="OverallSummary" Text="all clear" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                    <Border
                        x:Name="UnreadBadge"
                        Visibility="Collapsed"
                        CornerRadius="{StaticResource RadiusInner}"
                        Padding="7,1,7,1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                        <TextBlock x:Name="UnreadCount" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 看板主体：左=事件动态（时间线主区，吃满剩余高度内部滚动）；右=通知/概览/状态副栏（260 DIP） -->
            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <!-- B-602：Recent Events → 看板主区「事件动态」（PANEL-UPGRADE-1）：时刻/级别/来源/摘要逐行可读，
                     条数放宽（Core TimelineEntries.BoardMaxEntries=50）滚动承载；行字号 13/12 按大板面重排。
                     纵向 Grid（Auto 标签 + * 列表）而非 StackPanel：StackPanel 以无限高度量测子元素，
                     ListView 撑到全部内容高、溢出窗底被裁且滚动条永不出现（2026-10-10 用户实测右下角内容被切根因）；
                     * 行把列表压进剩余高度走内部滚动，底部 Padding 完整可见。 -->
                <Grid Grid.Column="0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="RecentHeader" Text="EVENT TIMELINE" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" CharacterSpacing="60" />
                    <ListView
                        Grid.Row="1"
                        x:Name="RecentList"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        ItemClick="OnRecentItemClick" />
                </Grid>

                <!-- 右副栏：NOTIFICATIONS（B-601）+ OVERVIEW（B-602 来源卡片过滤）+ NEEDS ATTENTION / RUNNING
                     （批3-补27 拍板④ master-plan §3.2）。竖排 StackPanel + 各列表 MaxHeight 内滚（同旧口径）；
                     状态区两区全空整块收起（面板回落三段观感）。 -->
                <StackPanel Grid.Column="1" Spacing="10">
                    <!-- B-601：通知中心（NotificationEngine.Records，notifications.json 落盘水合——跨重启带出历史）；
                         单击标已读，「全部已读」一键清 -->
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="NotificationsHeader" Text="NOTIFICATIONS" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" CharacterSpacing="60" />
                            <HyperlinkButton
                                Grid.Column="1"
                                x:Name="MarkAllReadButton"
                                Content="Mark all read"
                                FontSize="11"
                                Padding="4,0,4,0"
                                Click="OnMarkAllRead" />
                        </Grid>
                        <ListView
                            x:Name="NotificationList"
                            MaxHeight="150"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            ItemClick="OnNotificationItemClick" />
                    </StackPanel>

                    <!-- B-602：按来源卡片区（chip 过滤保留）：UniformGridLayout 随 260 副栏宽自动两列换行 -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="OverviewHeader" Text="OVERVIEW" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" CharacterSpacing="60" />
                        <ItemsRepeater x:Name="SourceCounts">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="118" MinItemHeight="44" MinRowSpacing="6" MinColumnSpacing="6" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- 批3-补27 拍板④（master-plan §3.2 三分区）：当前状态区——NEEDS ATTENTION（失败/超时/离线/过期）
                         与 RUNNING（Running/Queued），行语义与事件动态一致（单击进 L3、右键 Pin）。
                         两区皆空时整块隐藏，看板回落三段观感；MaxHeight 内滚（同通知口径，列表不吃满高度）。 -->
                    <StackPanel x:Name="StatusPanel" Spacing="6">
                        <TextBlock
                            x:Name="AttentionHeader"
                            Text="NEEDS ATTENTION"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            FontSize="11"
                            CharacterSpacing="60" />
                        <ListView
                            x:Name="AttentionList"
                            MaxHeight="120"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            ItemClick="OnStateItemClick" />
                        <TextBlock
                            x:Name="RunningHeader"
                            Text="RUNNING"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            FontSize="11"
                            CharacterSpacing="60" />
                        <ListView
                            x:Name="RunningList"
                            MaxHeight="96"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            ItemClick="OnStateItemClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
