<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Beacon.App.Windows.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Beacon Quick Panel">
    <!-- RFC §6.4：Flyout——亚克力瞬态面 + Fluent 主题资源（WinUI 栈规范：颜色走 ThemeResource，不硬编码 hex）；
         PANEL-UPGRADE-1 看板化：720x560 大板面；
         重设计方案 B（2026-11-11 用户拍板，主从反转；原型 board-redesign.html 方案 B）：
         头带（把手 affordance + 品牌标 #d4234a）→ 左「现在」296px 固定列（聚合灯+总览+需要关注告警项列表+概览卡收底）
         / 右时间线主区（rail 时间轴 + 跨日日期）+ 通知段（去 MaxHeight 硬顶、段内滚动）→ 状态脚条（运行中/正常 + 交互提示） -->
    <Border
        CornerRadius="{StaticResource RadiusPanel}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部（PANEL-UPGRADE-1 拖拽移动把手）：品牌标（#d4234a，ThemeColors.Brand）+ 未读通知徽标；
                 总览状态灯与 OverallSummary 移入左「现在」列打头（方案 B 主从反转）。
                 顶部居中点阵把手 affordance（方案 B 保留项：头部可拖但无任何可见线索的缺陷修复），悬停点阵转品牌色；
                 按住拖动整窗（PointerPressed 会话），松手落位记忆 shell-state -->
            <Grid
                x:Name="HeaderDragArea"
                Grid.Row="0"
                MinHeight="38"
                Background="Transparent">
                <StackPanel
                    x:Name="GrabHandle"
                    Orientation="Horizontal"
                    Spacing="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,5,0,0"
                    IsHitTestVisible="False">
                    <Ellipse Width="3" Height="3" />
                    <Ellipse Width="3" Height="3" />
                    <Ellipse Width="3" Height="3" />
                    <Ellipse Width="3" Height="3" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,8,16,2">
                    <Ellipse x:Name="BrandMark" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="Beacon" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border
                        x:Name="UnreadBadge"
                        Visibility="Collapsed"
                        CornerRadius="{StaticResource RadiusPill}"
                        Padding="7,1,7,1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                        <TextBlock x:Name="UnreadCount" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 看板主体（方案 B 主从反转）：左=「现在」296px 固定列（聚合灯 + 总览 + 需要关注告警项列表最大视觉权重
                 + 概览来源卡收底）；右=时间线主区（rail + 跨日日期）+ 通知段。段内各自滚动，无 MaxHeight 硬顶 -->
            <Grid Grid.Row="1" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="296" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左「现在」列（方案 B）：NOW 打头（聚合状态灯 + OverallSummary，UpdateHeader 现场刷），
                     「需要关注」告警项列表为主体（AttentionList，AutomationId 保持不变——场景 S/U 的 CI 锚零迁移），
                     空列表给「一切正常」空态；概览来源卡（B-602 点击过滤）收底部。列表压进剩余高度内部滚动 -->
                <Border Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                    <Grid RowSpacing="6" Margin="14,10,12,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5*" />
                            <RowDefinition Height="3*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="OverallLight" Width="10" Height="10" VerticalAlignment="Center" />
                            <TextBlock x:Name="OverallSummary" Text="all clear" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="AttentionHeader" Text="NEEDS ATTENTION" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                        <ListView
                            Grid.Row="2"
                            x:Name="AttentionList"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            ItemClick="OnStateItemClick" />
                        <StackPanel Grid.Row="2" x:Name="AttentionEmpty" Visibility="Collapsed" Padding="4,12,4,4" Spacing="2">
                            <TextBlock x:Name="AttentionEmptyText" Text="一切正常" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="AttentionEmptyHint" Text="没有需要关注的组件" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                        </StackPanel>
                        <!-- 概览卡收底：3* 行内自滚（评审修复：Auto 行无界，来源多时挤掉告警列表主体地位） -->
                        <ScrollViewer Grid.Row="3" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="OverviewHeader" Text="OVERVIEW" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                                    <TextBlock x:Name="OverviewCount" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsRepeater x:Name="SourceCounts">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="118" MinItemHeight="44" MinRowSpacing="6" MinColumnSpacing="6" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 右主区：上=事件动态时间线（rail 时间轴 + 跨日日期，B-602/PANEL-UPGRADE-1 拍板的主区语义
                     方案 B 反转为右位但主体地位保留），下=通知（B-601）。3*/2* 分行：两段各自内部滚动、
                     无 MaxHeight 硬顶（硬顶互相挤压、右栏溢出被裁的结构病消除）。
                     时间线空态（方案 A/B 保留项）：无事件「暂无事件」；过滤无匹配「无匹配，试试清除过滤」+ 清除入口 -->
                <Grid Grid.Column="1" RowSpacing="0" Margin="14,10,14,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="RecentHeader" Text="EVENT TIMELINE" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                        <ListView
                            Grid.Row="1"
                            x:Name="RecentList"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            ItemClick="OnRecentItemClick" />
                        <StackPanel Grid.Row="2" x:Name="TimelineEmpty" Visibility="Collapsed" Spacing="4" Padding="8,22,8,8" HorizontalAlignment="Center">
                            <TextBlock x:Name="TimelineEmptyText" Text="暂无事件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="TimelineFilterEmptyHint" Text="无匹配，试试清除过滤" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" Visibility="Collapsed" VerticalAlignment="Center" />
                                <HyperlinkButton
                                    x:Name="ClearFilterButton"
                                    Content="清除筛选"
                                    FontSize="12"
                                    Padding="4,0,4,0"
                                    Visibility="Collapsed"
                                    Click="OnClearFilter" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                    <!-- B-601：通知中心（NotificationEngine.Records，notifications.json 落盘水合——跨重启带出历史）；
                         单击标已读，「全部已读」一键清；列表吃剩余高度内部滚动（MaxHeight 硬顶消除）。
                         空态（保留项）：通知已全部已读给文案 -->
                    <Grid Grid.Row="2" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="NotificationsHeader" Text="NOTIFICATIONS" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                            <HyperlinkButton
                                Grid.Column="1"
                                x:Name="MarkAllReadButton"
                                Content="Mark all read"
                                FontSize="11"
                                Padding="4,0,4,0"
                                Click="OnMarkAllRead" />
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            x:Name="NotificationList"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            ItemClick="OnNotificationItemClick" />
                        <TextBlock
                            Grid.Row="1"
                            x:Name="NotificationsEmpty"
                            Text="通知已全部已读"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,22,0,0"
                            TextAlignment="Center"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- 状态脚条（保留项）：运行中/正常计数（「运行中」并入脚条）+ 交互提示（单击/右键/拖动/调尺寸/ESC），低对比整行 -->
            <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,6,16,6" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                        <Ellipse x:Name="FooterRunningDot" Width="6" Height="6" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterRunning" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <Ellipse x:Name="FooterOkDot" Width="6" Height="6" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterOk" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="FooterHintActions" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" x:Name="FooterHintWindow" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
