<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Beacon.App.Windows.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Beacon Quick Panel">
    <!-- RFC §6.4：Flyout——亚克力瞬态面 + Fluent 主题资源（WinUI 栈规范：颜色走 ThemeResource，不硬编码 hex） -->
    <Border
        CornerRadius="12"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 头部：总体状态灯 + 告警计数 + 未读通知徽标 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="OverallLight" Width="10" Height="10" Fill="#4ADE80" VerticalAlignment="Center" />
                <TextBlock Text="Beacon" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="OverallSummary" Text="all clear" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <Border
                    x:Name="UnreadBadge"
                    Visibility="Collapsed"
                    CornerRadius="8"
                    Padding="7,1,7,1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                    <TextBlock x:Name="UnreadCount" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                </Border>
            </StackPanel>

            <!-- B-601：通知中心（NotificationEngine.Records，notifications.json 落盘水合——跨重启带出历史）；
                 单击标已读，「全部已读」一键清 -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NOTIFICATIONS" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" CharacterSpacing="60" />
                    <HyperlinkButton
                        Grid.Column="1"
                        x:Name="MarkAllReadButton"
                        Content="全部已读"
                        FontSize="11"
                        Padding="4,0,4,0"
                        Click="OnMarkAllRead" />
                </Grid>
                <ListView
                    x:Name="NotificationList"
                    MaxHeight="118"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnNotificationItemClick" />
            </StackPanel>

            <!-- B-602：按来源计数区（GitHub / CI / …） -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="6">
                <TextBlock Text="OVERVIEW" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" CharacterSpacing="60" />
                <StackPanel x:Name="SourceCounts" Orientation="Horizontal" Spacing="6" />
            </StackPanel>

            <!-- B-602：Recent Events（状态变化流，与通知同源）；单击进 L3，右键 Pin。
                 纵向 Grid（Auto 标签 + * 列表）而非 StackPanel：StackPanel 以无限高度量测子元素，
                 ListView 撑到全部内容高、溢出窗底被裁且滚动条永不出现（2026-10-10 用户实测右下角内容被切根因）；
                 * 行把列表压进剩余高度走内部滚动，底部 14 DIP Padding 完整可见。 -->
            <Grid Grid.Row="3" Margin="0,12,0,0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="RECENT EVENTS" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" CharacterSpacing="60" />
                <ListView
                    Grid.Row="1"
                    x:Name="RecentList"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnRecentItemClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
