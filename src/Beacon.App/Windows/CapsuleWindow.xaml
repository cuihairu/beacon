<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Beacon.App.Windows.CapsuleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Beacon Status">
    <!-- RFC §6.2.2 形态规范：高 32 DIP、宽随内容、圆角胶囊、亚克力/半透明、随主题；
         构成 = 健康环 + 状态灯（微光晕）+ 极简计数（无正文文字）；离线降级见 §6.2.6（灰空心灯 + Last update）。
         2026-10-29 UI 升级（BrimDeck 对照）：注意力份额画环、光晕灯两层层叠、悬停展开各数据源摘要。
         2026-11-06 岛形态重做（USER-RPT-4，BrimDeck Notch 口径对拍）：
         ① 曲面 = IslandSurface 单路径（IslandSurfaceOutline，BrimDeck IslandBorder.BuildOutline 同式：
            顶缘贴屏幕顶横贯全宽、肩 16/肩深 7 内收出主体、底角 12、上角 0）——经典药丸的
            CornerRadius 药丸画法在岛形态下退场（RootBorder 透明零圆角零内边距，曲面自绘）；
         ② 内缩 = NotchInset 30 DIP（SurfaceStack.Margin），内容同时避让肩与底角；
         ③ 预览区在岛形态无底色无描边（曲面内无缝长出，展开读作「岛变高」而非「下方贴块」）。 -->
    <Grid x:Name="Root" Background="Transparent" PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" RightTapped="OnRightTapped">
        <StackPanel Spacing="4" VerticalAlignment="Center">
            <!-- RootBorder：经典 = RadiusPill 药丸（亚克力底+发丝描边，观感逐字节同旧）；
                 岛 = 透明容器（曲面、内缩、圆角全由代码侧按形态切换），Path 在内容之下自绘曲面 -->
            <Border
                x:Name="RootBorder"
                CornerRadius="{StaticResource RadiusPill}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="12,5">
                <Grid>
                    <!-- 岛曲面（岛形态才可见；代码侧按 ActualWidth/Height 从 IslandSurfaceOutline 生成） -->
                    <Path x:Name="IslandSurface" Visibility="Collapsed" Stretch="None" />
                    <StackPanel x:Name="SurfaceStack" Spacing="4">
                        <!-- 收起态行（高 32 的行容器）：经典 = 透明 0 边距（观感同旧） -->
                        <Border x:Name="PillArea" Padding="0">
                            <StackPanel x:Name="PillRow" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- 健康环：ok 份额弧段，环色=聚合级别色（每次 UpdateStatus 重建） -->
                                <ContentControl x:Name="HealthRing" Width="16" Height="16" VerticalAlignment="Center" IsTabStop="False" />
                                <!-- 状态灯（微光晕）：外层同色低透明晕 + 核心 Ø8 灯；OverallLight 是 G4/G5 像素锚，元素名与取色链不动。
                                     初始色由 ctor 代码侧喂 ThemeColors（WinUI 3 无 x:Static，XAML 不落 hex） -->
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse x:Name="OverallHalo" Width="15" Height="15" />
                                    <Ellipse x:Name="OverallLight" Width="8" Height="8" />
                                </Grid>
                                <TextBlock
                                    x:Name="CountText"
                                    Text="Beacon"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                <!-- 悬浮岛徽标（§7 Phase 2）：未读/异常计数（背景色代码侧按所指内容喂：未读=强调色、异常=级别色）；
                                     经典胶囊形态恒隐藏（RefreshBadge 门控），元素常驻以免形态切换重建树 -->
                                <Border
                                    x:Name="IslandBadge"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Padding="7,2"
                                    MinHeight="17"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="IslandBadgeCount"
                                        Text="0"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        VerticalAlignment="Center" />
                                </Border>
                                <!-- 品牌标：仅悬浮岛收起态显示（岛收起态计数文本让位给徽标，品牌由词标扛；
                                     经典胶囊计数零值时 "Beacon" 文本本就兼任品牌兜底，不动） -->
                                <TextBlock
                                    x:Name="BrandMark"
                                    Text="Beacon"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <!-- 悬停预览：各数据源一行（级别点 + 来源 + 摘要），PointerEntered 展开/退出收起；
                             无数据/拖动中不展开（宽随内容，行文本裁尾）。
                             岛形态：Margin 0、透明底、无独立描边（曲面内无缝长出，chrome 代码侧喂）；
                             宽上限由代码侧按曲面宽-两侧内缩喂（行在曲面内裁尾，不越出岛缘） -->
                        <Border
                            x:Name="SourcePreview"
                            CornerRadius="{ThemeResource RadiusInner}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="9,6"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 离线横幅：灰空心灯 + Last update（§4.1 Offline 灰空心），主题化半透明底 -->
            <Border
                x:Name="OfflineBanner"
                CornerRadius="{ThemeResource RadiusInner}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="9,4"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="Transparent" Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="OfflineText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
